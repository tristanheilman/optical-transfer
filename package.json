{
  "name": "optical-transfer",
  "version": "0.0.0",
  "private": true,
  "description": "Air-gapped file transfer over screen and camera, using LT fountain codes and animated QR frames.",
  "workspaces": [
    "packages/core",
    "packages/gif",
    "packages/react-native",
    "packages/react-native/example"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:viewer": "node web/viewer/build.mjs"
  },
  "author": "Tristan Heilman <tristanheilman@outlook.com> (https://github.com/tristanheilman)",
  "license": "MIT",
  "homepage": "https://github.com/tristanheilman/optical-transfer#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/tristanheilman/optical-transfer.git"
  },
  "bugs": {
    "url": "https://github.com/tristanheilman/optical-transfer/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
